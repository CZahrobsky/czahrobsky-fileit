# Liquibase Properties for Production

# Database Connection - SQL Server (Azure)
driver=com.microsoft.sqlserver.jdbc.SQLServerDriver
url=jdbc:sqlserver://YOUR_SERVER.database.windows.net:1433;databaseName=FileIt;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net
username=YourAdminUser@YourServer
password=${DB_PASSWORD}

# Liquibase Configuration
changeLogFile=./src/main/resources/db/changelog/db.changelog-master.sql
logLevel=warning
